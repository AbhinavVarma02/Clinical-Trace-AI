{
  "name": "clinical-trace-edge",
  "private": true,
  "version": "2.0.0",
  "description": "Cloudflare Worker edge for Clinical-Trace AI 2.0: static React workspace, guarded API gateway and Workers AI inference proxy.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "typecheck": "wrangler types --include-runtime && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "dev": "wrangler dev",
    "deploy:dry-run": "npm run build:assets && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "smoke": "node scripts/smoke.mjs https://clinical-trace-ai.room-for-both.workers.dev",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
