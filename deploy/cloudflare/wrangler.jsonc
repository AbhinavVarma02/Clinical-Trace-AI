// Clinical-Trace AI public edge. Workers Free plan only: every limit fails closed with an error,
// never with a charge. See docs/PUBLIC_DEPLOYMENT.md before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinical-trace-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/edge/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clinical-trace-edge",
      "database_id": "57896756-9a09-4aa7-a63b-7039482aa163",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "4201", "simple": { "limit": 120, "period": 60 } },
    { "name": "AGENT_LIMITER", "namespace_id": "4202", "simple": { "limit": 6, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "BACKEND_ORIGIN": "",
    "LLM_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "DAILY_NEURON_BUDGET": "8000",
    "DAILY_AGENT_RUNS_GLOBAL": "300",
    "DAILY_AGENT_RUNS_PER_CLIENT": "25",
    "RELEASE": "local"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
