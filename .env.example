# =============================================================
# Clinical-Trace AI - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All values below are placeholders only.
# =============================================================

# OpenAI (optional: needed for LLM explanations, not for predictions)
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith tracing (optional: needed for LLM tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=clinical-trace-ai

# Application
API_HOST=0.0.0.0
API_PORT=8000

# Model configuration
MODEL_PATH=models/best_model.joblib
PIPELINE_PATH=models/preprocessing_pipeline.joblib
RISK_THRESHOLD=0.30

# Clinical-Trace AI 2.0 agent (optional). Without a provider the agent runs in
# deterministic mode and labels its answers accordingly.
# CLINICAL_TRACE_LLM_PROVIDER=ollama            # none | ollama | openai-compatible
# CLINICAL_TRACE_LLM_MODEL=qwen2.5:7b
# CLINICAL_TRACE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CLINICAL_TRACE_LLM_API_KEY=your_provider_token_here
# CLINICAL_TRACE_DB_PATH=var/clinical_trace.db
